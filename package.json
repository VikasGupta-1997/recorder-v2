{
  "name": "adilo-browser-recorder-extension",
  "displayName": "Adilo browser recorder extension",
  "version": "0.0.1",
  "description": "A Video and Audio recording extention.",
  "author": "softwaredev@zestgeek.com",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "firefox-dev": "plasmo dev --target=firefox-mv2",
    "firefox-build": "plasmo build --target=firefox-mv2",
    "firefox-package": "plasmo package --target=firefox-mv2"
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.6.2",
    "@plasmohq/storage": "^1.11.0",
    "@types/wavesurfer.js": "^6.0.12",
    "lodash.debounce": "^4.0.8",
    "plasmo": "0.89.3",
    "plyr-react": "^5.3.0",
    "react": "18.3.1",
    "react-audio-visualize": "^1.2.0",
    "react-dom": "18.3.1",
    "react-draggable": "^4.4.6",
    "react-icons": "^5.3.0",
    "react-player": "^2.16.0",
    "react-select": "^5.8.1",
    "wavesurfer.js": "^7.8.9"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.3.1",
    "@plasmohq/parcel-resolver": "^0.14.1",
    "@types/chrome": "0.0.277",
    "@types/node": "22.7.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prettier": "3.3.3",
    "tailwindcss": "^3.4.13",
    "typescript": "5.6.3"
  },
  "manifest": {
    "host_permissions": [
      "<all_urls>"
    ],
    "permissions": [
      "storage",
      "downloads",
      "activeTab",
      "scripting",
      "tabCapture",
      "tabs",
      "desktopCapture",
      "tabCapture",
      "offscreen",
      "app.window",
      "system.display",
      "unlimitedStorage",
      "webRequest"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "tabs/*",
          "vendor/*",
          "ffmpeg/*",
          "sandboxes/*",
          "sandboxes/demo.tsx",
          "context.tsx"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ],
    "sandbox": {
      "pages": [
        "sandboxes/demo.tsx"
      ]
    },
    "cross_origin_embedder_policy": {
      "value": "require-corp"
    },
    "cross_origin_opener_policy": {
      "value": "same-origin"
    },
    "content_security_policy": {
      "sandbox": "sandbox allow-scripts allow-modals allow-popups; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; object-src 'self';worker-src 'self' blob: ;",
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; media-src 'self' data: blob: *;"
    }
  }
}
